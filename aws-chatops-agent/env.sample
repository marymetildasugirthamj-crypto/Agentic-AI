# ─────────────────────────────────────────────────────────────
#  RENAME THIS FILE:   env.sample  →  .env      (or just: env)
#  macOS/Linux:        cp env.sample .env
#  Windows (cmd):      copy env.sample .env
#  Then paste your OpenAI key below. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# The agent's brain (required for the real gpt-4o agent; without it, an offline
# fallback brain handles a few demo intents so the UI still runs).
OPENAI_API_KEY=sk-paste-your-key-here
MODEL=gpt-4o

# ── AWS mode ──────────────────────────────────────────────────
# false = MOCK cloud (safe demo data, no AWS account needed) — recommended for demos
# true  = REAL AWS via boto3 (uses your normal AWS credential chain below)
USE_REAL_AWS=false

# Only needed when USE_REAL_AWS=true (or configure ~/.aws / an IAM role instead):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
