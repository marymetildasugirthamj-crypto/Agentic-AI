# RENAME to .env (cp env.sample .env), then paste your keys. NEVER commit .env.
OPENAI_API_KEY=sk-paste-your-key-here
MODEL=gpt-4o

# Cost dashboard hits real Cost Explorer when true (needs CE enabled ~24h);
# optimization detectors always run live against the account when true.
USE_REAL_AWS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
